# The kernels and initrds change every build but keep stable names, so they
# must NOT be immutable — revalidate each load (304 when unchanged, full
# download only when the build actually changed). This is the fix for a
# stale machine surviving a redeploy.
/v86/undesk-initrd.cpio
  Cache-Control: public, max-age=0, must-revalidate
/v86/undesk-vmlinuz
  Cache-Control: public, max-age=0, must-revalidate
/v86/alpenglow-v86-initrd.cpio.gz
  Cache-Control: public, max-age=0, must-revalidate
/v86/alpenglow-v86-vmlinuz
  Cache-Control: public, max-age=0, must-revalidate

# The BIOS and vga BIOS are upstream and never change. (The wasm is covered
# by the /*.wasm rule below; listing it here too double-stacks the header.)
/v86/*.bin
  Cache-Control: public, max-age=604800, immutable
/v86/libv86.mjs
  Cache-Control: public, max-age=604800, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Cache-Control: public, max-age=604800, immutable
