{
  "name": "@workspace/undivisible",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun run serve",
    "sync:readme": "bun run scripts/sync-readme-projects.ts",
    "sync:now": "bun run scripts/sync-now-markdown.ts",
    "sync:resume": "bun run scripts/sync-resume.ts",
    "sync:lastfm": "bun run scripts/sync-lastfm-snapshot.ts",
    "sync:agent": "bun run scripts/sync-agent-public.ts",
    "prebuild": "bun run sync:readme && bun run sync:now && bun run sync:resume && bun run sync:lastfm && bun run sync:agent",
    "build": "bun run scripts/build-static.ts",
    "format": "bunx prettier --check .",
    "lint": "bun run typecheck",
    "serve": "bun run scripts/serve-static.ts",
    "test": "bun test",
    "typecheck": "bun run types:worker && bunx tsc -p tsconfig.json --noEmit && bunx tsc -p server/tsconfig.json --noEmit",
    "types:worker": "WRANGLER_SEND_METRICS=false wrangler types server/worker-configuration.d.ts --config wrangler.jsonc --env-interface WorkerEnv",
    "dev:worker": "WRANGLER_SEND_METRICS=false wrangler dev --config wrangler.jsonc --port 8790 --local-upstream localhost:8790 --var NEXNET_ORIGIN:http://localhost:8790"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/bun": "1.3.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@unocss/core": "66.11.0",
    "@unocss/preset-wind4": "66.11.0",
    "@unocss/transformer-directives": "66.11.0",
    "lightningcss": "^1.33.0",
    "magic-string": "^1.4.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "wrangler": "4.151.0"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@simplewebauthn/server": "13.2.2",
    "@tschk/moonshine": "^0.4.0",
    "@tschk/moonshine-compiler": "^0.4.0",
    "@tschk/moonshine-framework": "^0.4.0",
    "@tschk/moonshine-next": "^0.4.0",
    "@tschk/moonshine-react": "^0.4.0",
    "@tschk/moonshine-router": "^0.4.0",
    "@tschk/moonshine-server": "^0.4.0",
    "cbor2": "1.12.0",
    "motion": "^12.38.0"
  }
}
