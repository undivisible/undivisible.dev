{
  "name": "@workspace/undivisible",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun run serve",
    "sync:readme": "bun run scripts/sync-readme-projects.ts",
    "sync:now": "bun run scripts/sync-now-markdown.ts",
    "sync:resume": "bun run scripts/sync-resume.ts",
    "sync:lastfm": "bun run scripts/sync-lastfm-snapshot.ts",
    "sync:agent": "bun run scripts/sync-agent-public.ts",
    "prebuild": "bun run sync:readme && bun run sync:now && bun run sync:resume && bun run sync:lastfm && bun run sync:agent",
    "build": "bun run scripts/build-static.ts",
    "format": "bunx prettier --check .",
    "lint": "bun run typecheck",
    "serve": "bun run scripts/serve-static.ts",
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "@tailwindcss/typography": "^0.5.15",
    "@types/bun": "1.3.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0"
  },
  "dependencies": {
    "@tschk/moonshine": "^0.3.3",
    "@tschk/moonshine-compiler": "^0.3.3",
    "@tschk/moonshine-framework": "^0.3.3",
    "@tschk/moonshine-next": "^0.3.3",
    "@tschk/moonshine-react": "^0.3.3",
    "@tschk/moonshine-router": "^0.3.3",
    "@tschk/moonshine-server": "^0.3.3",
    "motion": "^12.38.0"
  }
}
