#!/bin/sh
# alpensky — the background is a real program.
# Reads the machine's own clock and sets the VT palette to the hour's sky:
# indices 0 (background) and 4/6/12/14 (accents) shift through dawn, day,
# dusk and night. The Linux console applies \e]PXRRGGBB immediately.
T=/dev/tty1
hour=$(date -u +%H 2>/dev/null || echo 12)
# Hong Kong time from UTC.
hour=$(( (hour + 8) % 24 ))
case "$hour" in
  5|6|7)      bg=1a1420; ac=e8896a; ac2=f0b27a ;;  # dawn
  8|9|10|11)  bg=101a26; ac=6aa6d6; ac2=a8c8e8 ;;  # morning
  12|13|14)   bg=0e1c2c; ac=7ab8e8; ac2=cfe6f8 ;;  # noon
  15|16|17)   bg=161a24; ac=d6a06a; ac2=e8c89a ;;  # afternoon
  18|19)      bg=1c1018; ac=d67a8a; ac2=e8a8b8 ;;  # dusk
  *)          bg=07070c; ac=4a5a7a; ac2=8a9ab8 ;;  # night
esac
printf '\033]P0%s' "$bg"  > "$T"
printf '\033]P4%s' "$ac"  > "$T"
printf '\033]P6%s' "$ac"  > "$T"
printf '\033]PC%s' "$ac2" > "$T"
printf '\033]PE%s' "$ac2" > "$T"
printf '\033]P7c8c8d0' > "$T"
printf '\033]P8585866' > "$T"
printf '\033]PFfafafa' > "$T"
