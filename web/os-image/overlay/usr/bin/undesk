#!/bin/sh
# undesk, sh edition — the desktop is one prompt.
#
# The same philosophy as the GPUI build in tschk/alpenglowed, executed by
# the machine this actually runs on: no wallpaper of icons, no taskbar —
# a text bar that launches everything, with apps as executable files in
# /usr/share/undesk/apps. Runs on tty1 over fbcon.
T=/dev/tty1
APPS=/usr/share/undesk/apps
export TERM=linux

rows=$(stty size 2>/dev/null | cut -d' ' -f1); [ -n "$rows" ] || rows=48
cols=$(stty size 2>/dev/null | cut -d' ' -f2); [ -n "$cols" ] || cols=128

draw_home() {
  clear
  printf '\033[%d;1H' 3
  printf '  \033[1;37malpenglow\033[0m \033[90m— the web build of a real linux, on your cpu\033[0m\n\n'
  printf '  \033[90mtype a name and press enter. `!cmd` runs a shell command.\033[0m\n\n'
  for app in "$APPS"/*; do
    name=$(basename "$app")
    desc=$(sed -n '3s/^# *//p' "$app")
    printf '   \033[96m>\033[0m %-12s \033[90m%s\033[0m\n' "$name" "$desc"
  done
  printf '\n   \033[96m>\033[0m %-12s \033[90m%s\033[0m\n' "sh" "a real shell (exit comes back)"
  printf '\n'
}

unsky
draw_home
while :; do
  printf '  \033[1;36m>\033[0m '
  read -r line || continue
  cmd=${line%% *}
  case "$line" in
    "") draw_home ;;
    "!"*) sh -c "${line#!}"; printf '\n  \033[90m[enter to continue]\033[0m'; read -r _; draw_home ;;
    sh|bash) /bin/bash --login -i; draw_home ;;
    exit|quit) draw_home ;;
    *)
      if [ -x "$APPS/$cmd" ]; then
        "$APPS/$cmd" "${line#"$cmd"}"; draw_home
      else
        match=""
        for app in "$APPS"/*; do
          case "$(basename "$app")" in "$cmd"*) match="$app"; break ;; esac
        done
        if [ -n "$match" ]; then "$match"; draw_home
        else printf '  \033[91m%s: not found\033[0m\n' "$cmd"; fi
      fi
      ;;
  esac
done
