{
  "name": "@workspace/undivisible-moonshine",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "sync": "bun run scripts/sync-content.ts",
    "build:client": "bun build ./src/client.tsx --outdir=public --target=browser --format=esm --minify",
    "predev": "bun run sync",
    "dev": "bun run build:client && bun run --watch src/server.ts",
    "prestart": "bun run sync && bun run build:client",
    "start": "bun run src/server.ts",
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tschk/moonshine": "^0.3.1",
    "@tschk/moonshine-framework": "^0.3.1",
    "@tschk/moonshine-react": "^0.3.1",
    "@tschk/moonshine-server": "^0.3.1",
    "@tschk/moonshine-deploy-bun": "^0.3.1",
    "@tschk/moonshine-adapter-conformance": "^0.3.1",
    "@tschk/moonshine-shaders": "^0.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "~7.0.0"
  }
}
