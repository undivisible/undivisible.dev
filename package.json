{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock pnpm-lock.yaml; case \"$npm_config_user_agent\" in bun/*) ;; *) echo \"Use bun\" >&2; exit 1 ;; esac'",
    "build": "bunx turbo run build",
    "build:web": "bunx turbo run build --filter=@workspace/undivisible",
    "format": "bunx prettier --check .",
    "lint": "bunx turbo run lint",
    "test": "bunx turbo run test",
    "typecheck": "bunx turbo run typecheck",
    "dev": "bunx turbo run dev --filter=@workspace/undivisible",
    "dev:all": "bunx turbo run dev"
  },
  "packageManager": "bun@1.3.11",
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.9.7",
    "typescript": "~5.9.2"
  },
  "workspaces": {
    "packages": [
      "web",
      "old/9.1",
      "lib/*",
      "lib/integrations/*",
      "scripts"
    ],
    "catalog": {
      "@replit/vite-plugin-cartographer": "^0.5.1",
      "@replit/vite-plugin-dev-banner": "^0.1.1",
      "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
      "@tailwindcss/vite": "^4.1.14",
      "@tanstack/react-query": "^5.90.21",
      "@types/node": "^25.3.3",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "@vitejs/plugin-react": "^5.0.4",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "drizzle-orm": "^0.45.2",
      "framer-motion": "^12.23.24",
      "lucide-react": "^0.545.0",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "tailwind-merge": "^3.3.1",
      "tailwindcss": "^4.1.14",
      "tsx": "^4.21.0",
      "vite": "^7.3.2",
      "wouter": "^3.3.5",
      "zod": "^3.25.76"
    }
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "esbuild": "0.27.3"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.27.3",
    "@rollup/rollup-darwin-arm64": "4.59.0",
    "@tailwindcss/oxide-darwin-arm64": "4.2.1",
    "lightningcss-darwin-arm64": "1.31.1"
  },
  "dependencies": {
    "ghostty-web": "0.4.0"
  }
}
